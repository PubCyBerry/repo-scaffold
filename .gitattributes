# 줄바꿈은 저장소와 워킹트리 모두 LF로 통일한다.
# Windows에서 작업해도 CRLF 변환 경고가 나지 않고, WSL, 원격 리눅스와 파일이 갈라지지 않는다.
* text=auto eol=lf

# 셸 스크립트는 CRLF면 실행이 깨지므로 명시적으로 고정한다.
*.sh   text eol=lf
*.bash text eol=lf

# 확장자가 없어 * 규칙에 걸리지 않는 파일. just 는 CRLF 레시피를 그대로 셸에 넘긴다.
Justfile text eol=lf

# Windows 전용 스크립트만 예외로 CRLF를 유지한다.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# 바이너리: 줄바꿈 변환과 diff 대상에서 제외한다.
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.pdf  binary
*.zip  binary
*.gz   binary
*.xlsx binary
*.docx binary
*.pptx binary

# 락 파일은 diff 노이즈가 커서 접어둔다. 병합은 정상 동작한다.
uv.lock          linguist-generated=true -diff
package-lock.json linguist-generated=true -diff
pnpm-lock.yaml   linguist-generated=true -diff
poetry.lock      linguist-generated=true -diff
