{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://repo-scaffold.invalid/schemas/docs-frontmatter.schema.json",
  "title": "docs front matter",
  "description": "docs/ 아래 문서 front matter 의 기계 계약. 사람이 읽는 원본은 docs/standards/documentation.md 다. 검사기는 tests/check-docs-metadata.sh 가 부르는 check-jsonschema 다.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "title",
    "type",
    "status",
    "summary",
    "scope",
    "read_when"
  ],
  "properties": {
    "id": {
      "description": "<type>-<slug>. 파일을 옮겨도 따라온다",
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)+$"
    },
    "title": {
      "description": "본문 H1 과 같아야 한다",
      "type": "string",
      "minLength": 1
    },
    "type": {
      "description": "문서 갈래. 디렉터리와 일대일로 대응한다",
      "enum": [
        "index",
        "standard",
        "guide",
        "reference",
        "generated",
        "decision"
      ]
    },
    "status": {
      "description": "type 마다 허용 값이 다르다. 아래 allOf 가 짝을 검사한다",
      "enum": [
        "active",
        "draft",
        "deprecated",
        "outdated",
        "archived",
        "current",
        "stale",
        "proposed",
        "accepted",
        "rejected",
        "superseded"
      ]
    },
    "summary": {
      "description": "개조식 한 줄. 마침표로 끝내지 않는다",
      "type": "string",
      "minLength": 1,
      "pattern": "[^.]$"
    },
    "scope": {
      "description": "이 문서가 적용되는 범위. 저장소 루트 기준 경로이고 glob 을 쓸 수 있다",
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9_.*][A-Za-z0-9_./*-]*$"
      }
    },
    "read_when": {
      "description": "언제 읽어야 하는지. 제목을 다시 쓰지 않는다",
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "owners": {
      "description": "책임 주체. 소유가 갈릴 때만 쓴다",
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "last_reviewed": {
      "description": "사람이 마지막으로 검토한 날. 도구가 자동으로 올리지 않는다",
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "review_interval_days": {
      "description": "검토 주기. 없으면 type 별 기본값을 쓴다. 0 은 시간으로 낡지 않는다는 뜻이다",
      "type": "integer",
      "minimum": 0,
      "maximum": 3650
    },
    "sources": {
      "description": "이 문서가 서술하는 저장소 안 경로. source drift 의 입력이다. glob 을 쓰지 않는다",
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9_.][A-Za-z0-9_./-]*$"
      }
    },
    "related": {
      "description": "같이 읽는 문서의 id. 파일 경로가 아니다",
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]+(-[a-z0-9]+)+$"
      }
    },
    "supersedes": {
      "description": "이 문서가 대체하는 문서의 id. 파일 경로가 아니다",
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]+(-[a-z0-9]+)+$"
      }
    },
    "generated_from": {
      "description": "생성 원본 경로. type generated 에 필수다. source drift 에서 sources 와 같이 취급한다",
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9_.][A-Za-z0-9_./-]*$"
      }
    },
    "edit_policy": {
      "description": "편집 제한. 손으로 고치지 않는 문서에만 쓴다",
      "enum": [
        "generated"
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "type": { "const": "index" } },
        "required": ["type"]
      },
      "then": {
        "properties": { "status": { "enum": ["active"] } }
      }
    },
    {
      "if": {
        "properties": { "type": { "const": "standard" } },
        "required": ["type"]
      },
      "then": {
        "properties": { "status": { "enum": ["draft", "active", "deprecated"] } }
      }
    },
    {
      "if": {
        "properties": { "type": { "const": "guide" } },
        "required": ["type"]
      },
      "then": {
        "properties": { "status": { "enum": ["draft", "active", "outdated"] } }
      }
    },
    {
      "if": {
        "properties": { "type": { "const": "reference" } },
        "required": ["type"]
      },
      "then": {
        "properties": { "status": { "enum": ["active", "outdated", "archived"] } }
      }
    },
    {
      "if": {
        "properties": { "type": { "const": "generated" } },
        "required": ["type"]
      },
      "then": {
        "properties": { "status": { "enum": ["current", "stale"] } },
        "required": ["generated_from"]
      }
    },
    {
      "if": {
        "properties": { "type": { "const": "decision" } },
        "required": ["type"]
      },
      "then": {
        "properties": {
          "status": { "enum": ["proposed", "accepted", "rejected", "superseded"] }
        }
      }
    }
  ]
}
