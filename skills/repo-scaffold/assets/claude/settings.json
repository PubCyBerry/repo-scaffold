{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(bash tests/check-docs.sh:*)",
      "Bash(bash tests/check-env.sh:*)",
      "Bash(bash tests/check-secrets.sh:*)",
      "Bash(bash scripts/gen-doc-index.sh:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git ls-files:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./**/.env)"
    ]
  }
}
