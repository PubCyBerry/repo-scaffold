# https://editorconfig.org
# .gitattributes 가 커밋 시점을 잡고, 이 파일이 편집 시점을 잡는다. 둘 다 있어야 왕복이 안정된다.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4
# 줄 길이 100 은 .rumdl.toml, pyproject.toml, commitlint.config.mjs 와 같은 값이다.
# 편집기가 이 값을 읽어 안내선을 그린다. 강제는 각 도구가 한다.
max_line_length = 100

[*.{md,mdx}]
# 마크다운은 줄 끝 공백 두 개가 줄바꿈이라 자르지 않는다.
trim_trailing_whitespace = false

[*.{yml,yaml,json}]
indent_size = 2

[*.{sh,bash}]
# shfmt 가 여기서 형식 기준을 읽는다. 명령줄에 형식 플래그를 하나라도 주면
# shfmt 가 이 파일을 통째로 무시하므로, 훅과 CI 모두 플래그 없이 부른다.
switch_case_indent = true
binary_next_line = true
space_redirects = true

[*.{bat,cmd,ps1}]
end_of_line = crlf

[Makefile]
indent_style = tab
