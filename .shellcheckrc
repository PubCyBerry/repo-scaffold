# shellcheck 설정. tests/check-shell.sh 와 shell-lint 훅이 이 파일을 기준으로 돈다.
#
# 여기에는 저장소 전체에 걸리는 해석 설정만 둔다. 개별 지적은 여기서 끄지 않는다.
# 끌 이유가 있으면 그 줄 바로 위에 대상과 사유를 함께 적는다.
#
#   # shellcheck disable=SC2016  # 작은따옴표는 의도한 것이다. awk 가 리터럴로 읽는다
#
# 저장소 전체 disable 은 어느 스크립트의 어느 줄이 왜 예외인지 알 수 없게 만들고,
# 나중에 같은 번호로 진짜 결함이 들어와도 조용히 지나간다.
# 규약은 docs/standards/shell.md 에 있다.

# source 로 읽는 파일을 따라 들어가 함께 검사한다.
# 없으면 저장소 안에 실재하는 파일을 source 해도 전부 SC1091 로 뜬다.
external-sources=true

# source 경로를 스크립트가 있는 디렉터리 기준으로 푼다.
# 없으면 부른 디렉터리 기준이라 훅과 CI 와 손으로 돌릴 때 결과가 갈린다.
source-path=SCRIPTDIR
